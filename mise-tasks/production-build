#!/usr/bin/env zsh
#MISE description="Build production-ready "
#MISE depends=["lint"]
BACKEND=0 rollup -c
cp -r app/assets/* public
minify --type css app/styles.css --output public/app.min.css
touch public/app.min.css
sed -e 's/GLOBALS_URL/https:\/\/homely-uncomfortable-wreckfish.gigalixirapp.com\/js\/globals/' app/assets/index.html | sed s/RELEASE_DATE/`date -Idate`/ >public/index.html
date
echo Ready for deployment
